{
  "name": "ngu-form",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "form": "ng serve demo",
    "dropdown": "ng serve ngu-dropdown-demo",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:form": "ng build ngu-form && node projects/ngu-form/schematics/build.mjs && node projects/docs-kit/agents/generate.mjs projects/demo/agent-docs.json --package dist/ngu-form",
    "build:dropdown": "ng build ngu-dropdown && node projects/docs-kit/agents/generate.mjs projects/ngu-dropdown-demo/agent-docs.json --package dist/ngu-dropdown"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cdk": "22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/material": "22.2.2",
    "@primeuix/themes": "3.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "primeng": "22.1.2",
    "shiki": "4.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "zod": "4.6.5"
  }
}
