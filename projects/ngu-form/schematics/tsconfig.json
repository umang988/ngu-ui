{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "outDir": "../../../dist/ngu-form/schematics",
    "rootDir": ".",
    "strict": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "types": []
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
