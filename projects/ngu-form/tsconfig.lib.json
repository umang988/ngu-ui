/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "types": [],
    // ngu-form/dropdown builds against the published shape of ngu-dropdown (build it first),
    // not its source: the source is outside this package.
    "paths": {
      "ngu-dropdown": ["../../dist/ngu-dropdown"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
