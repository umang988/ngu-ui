{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ngu-form": {
      "projectType": "library",
      "root": "projects/ngu-form",
      "sourceRoot": "projects/ngu-form/src",
      "prefix": "ngu",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ngu-form/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngu-form/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngu-form/tsconfig.spec.json"
          }
        }
      }
    },
    "ngu-dropdown": {
      "projectType": "library",
      "root": "projects/ngu-dropdown",
      "sourceRoot": "projects/ngu-dropdown/src",
      "prefix": "ngu",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ngu-dropdown/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngu-dropdown/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngu-dropdown/tsconfig.spec.json"
          }
        }
      }
    },
    "ngu-table": {
      "projectType": "library",
      "root": "projects/ngu-table",
      "sourceRoot": "projects/ngu-table/src",
      "prefix": "ngu",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ngu-table/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngu-table/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngu-table/tsconfig.spec.json"
          }
        }
      }
    },
    "demo": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/demo",
      "sourceRoot": "projects/demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/demo/src/main.ts",
            "tsConfig": "projects/demo/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/demo/public"
              },
              {
                "glob": "**/*.ts",
                "input": "projects/demo/src/app/examples",
                "output": "source",
                "ignore": [
                  "**/*.spec.ts"
                ]
              },
              {
                "glob": "**/*.ts",
                "input": "projects/demo/src/app/docs/demos",
                "output": "source/docs",
                "ignore": [
                  "**/*.spec.ts"
                ]
              },
              {
                "glob": "CHANGELOG.md",
                "input": "projects/ngu-form",
                "output": "source"
              }
            ],
            "styles": [
              "projects/docs-kit/styles/base.scss",
              "projects/docs-kit/styles/docs.scss",
              "projects/demo/src/styles.scss",
              {
                "input": "projects/demo/src/material-theme.scss",
                "bundleName": "material-theme",
                "inject": false
              },
              {
                "input": "projects/demo/src/tailwind-demo.css",
                "bundleName": "tailwind-demo",
                "inject": false
              }
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "680kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "demo:build:production"
            },
            "development": {
              "buildTarget": "demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "ngu-dropdown-demo": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/ngu-dropdown-demo",
      "sourceRoot": "projects/ngu-dropdown-demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/ngu-dropdown-demo/src/main.ts",
            "tsConfig": "projects/ngu-dropdown-demo/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ngu-dropdown-demo/public"
              },
              {
                "glob": "**/*.ts",
                "input": "projects/ngu-dropdown-demo/src/app/demos",
                "output": "source/docs",
                "ignore": [
                  "**/*.spec.ts"
                ]
              },
              {
                "glob": "CHANGELOG.md",
                "input": "projects/ngu-dropdown",
                "output": "source"
              }
            ],
            "styles": [
              "projects/docs-kit/styles/base.scss",
              "projects/docs-kit/styles/docs.scss",
              "projects/ngu-dropdown-demo/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "520kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ngu-dropdown-demo:build:production"
            },
            "development": {
              "buildTarget": "ngu-dropdown-demo:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4301
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngu-dropdown-demo/tsconfig.spec.json"
          }
        }
      }
    },
    "ngu-table-demo": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/ngu-table-demo",
      "sourceRoot": "projects/ngu-table-demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/ngu-table-demo/src/main.ts",
            "tsConfig": "projects/ngu-table-demo/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ngu-table-demo/public"
              },
              {
                "glob": "**/*.ts",
                "input": "projects/ngu-table-demo/src/app/demos",
                "output": "source/docs",
                "ignore": [
                  "**/*.spec.ts"
                ]
              },
              {
                "glob": "CHANGELOG.md",
                "input": "projects/ngu-table",
                "output": "source"
              }
            ],
            "styles": [
              "projects/docs-kit/styles/base.scss",
              "projects/docs-kit/styles/docs.scss",
              "projects/ngu-table-demo/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "520kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "14kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ngu-table-demo:build:production"
            },
            "development": {
              "buildTarget": "ngu-table-demo:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4302
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngu-table-demo/tsconfig.spec.json"
          }
        }
      }
    },
    "size-check": {
      "projectType": "application",
      "root": "projects/size-check",
      "sourceRoot": "projects/size-check/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/size-check/src/main.ts",
            "index": "projects/size-check/src/index.html",
            "tsConfig": "projects/size-check/tsconfig.app.json",
            "outputPath": "dist/size-check/ngu"
          },
          "configurations": {
            "production": {
              "outputHashing": "none",
              "statsJson": true
            },
            "plain": {
              "outputHashing": "none",
              "statsJson": true,
              "outputPath": "dist/size-check/plain",
              "browser": "projects/size-check/src/main.plain.ts"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "ssr-check": {
      "projectType": "application",
      "root": "projects/ssr-check",
      "sourceRoot": "projects/ssr-check/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/ssr-check/src/main.ts",
            "server": "projects/ssr-check/src/main.server.ts",
            "index": "projects/ssr-check/src/index.html",
            "tsConfig": "projects/ssr-check/tsconfig.app.json",
            "outputMode": "static",
            "outputPath": "dist/ssr-check"
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
